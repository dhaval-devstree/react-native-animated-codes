    "code128",
    "code39",
    "datamatrix",
    "pdf417",
    "aztec",
    "maxicode",
    "gs1",
    "bwip-js"
  ],
  "author": "Dhaval <dhaval.devstree@gmail.com>",
  "bugs": {
    "url": "https://github.com/dhaval-devstree/react-native-animated-codes/issues"
  },
  "homepage": "https://github.com/dhaval-devstree/react-native-animated-codes",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3.6.0",
    "react-native-svg": ">=13"
  },
  "dependencies": {
