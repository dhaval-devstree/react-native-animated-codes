{
  "name": "react-native-animated-codes",
  "version": "1.0.1",
  "description": "Fully customizable animated QR codes and barcodes (100+ formats: EAN, UPC, Code 128, Code 39, ITF, Data Matrix, PDF417, Aztec, MaxiCode, postal...) for React Native (Android & iOS), built on react-native-svg and react-native-reanimated.",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "types": "lib/commonjs/index.d.ts",
  "typings": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaval-devstree/react-native-animated-codes"
  },
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "qrcode",
