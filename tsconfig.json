{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["react", "react-native"]
  },
  "include": ["src"]
}
